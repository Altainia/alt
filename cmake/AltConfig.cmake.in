@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# alt::alt links Threads::Threads PUBLIC, because the coroutine headers use
# std::mutex, std::condition_variable, std::binary_semaphore and std::stop_callback.
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/AltTargets.cmake")
check_required_components(Alt)
