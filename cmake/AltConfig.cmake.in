@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# alt::alt links Threads::Threads PUBLIC, because the coroutine headers use
# std::mutex, std::condition_variable, std::binary_semaphore and std::stop_callback.
find_dependency(Threads)

# alt::alt links liburing PRIVATE on Linux, but it is a static library unless
# BUILD_SHARED_LIBS is set, and a static library propagates even its PRIVATE link
# dependencies to consumers as $<LINK_ONLY:PkgConfig::LIBURING>. AltTargets.cmake
# therefore names that imported target, and this file must define it: find_dependency
# (PkgConfig) alone does not. The target is created with the same call the build used.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_dependency(PkgConfig)
    pkg_check_modules(LIBURING REQUIRED IMPORTED_TARGET liburing>=2.1)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AltTargets.cmake")
check_required_components(Alt)
